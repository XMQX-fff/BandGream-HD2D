{
  "name": "ot2-hd2d-harbor",
  "version": "1.0.0",
  "private": true,
  "description": "HD-2D 风格港口小镇 · 基于 three.js 的浏览器 3D 游戏原型（视觉参考《歧路旅人 2》）",
  "type": "module",
  "scripts": {
    "dev": "vite",
