  "keywords": [
    "three.js",
    "webgl",
    "hd-2d",
    "pixel-art"
  ],
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.3"
  }
}